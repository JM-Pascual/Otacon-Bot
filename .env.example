# Copy this file to .env and fill in real values. .env is gitignored -
# never commit it.

# Token from @BotFather after creating the bot.
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Your own numeric Telegram user id (NOT a username). See README.md for
# how to find this without hardcoding it or using a third-party bot.
TELEGRAM_AUTHORIZED_USER_ID=000000000
